#!/usr/bin/env bash
# WizardingCode Quality Gate — composer arka:gate
# 10-phase pipeline. Fails fast. Outputs storage/arka/gate-report.json.

set -uo pipefail

REPORT_DIR="storage/arka"
REPORT_FILE="$REPORT_DIR/gate-report.json"
START_TIME=$(date +%s)

mkdir -p "$REPORT_DIR"

phases_results="["
phase_id=0
overall_status="passed"

run_phase() {
    local id="$1"
    local label="$2"
    local cmd="$3"
    local required="${4:-true}"

    phase_id=$((phase_id + 1))
    local phase_start=$(date +%s)
    printf "[%d/10] %s ..." "$phase_id" "$label"

    set +e
    eval "$cmd" >/dev/null 2>"$REPORT_DIR/last-error.log"
    local exit_code=$?
    set -e

    local phase_end=$(date +%s)
    local duration=$((phase_end - phase_start))

    if [[ $exit_code -eq 0 ]]; then
        printf " ✓ %ds\n" "$duration"
        local status="passed"
    else
        printf " ✗ %ds\n" "$duration"
        local status="failed"
        if [[ "$required" == "true" ]]; then
            overall_status="failed"
        fi
        cat "$REPORT_DIR/last-error.log"
    fi

    if [[ "$phases_results" != "[" ]]; then
        phases_results="${phases_results},"
    fi
    phases_results="${phases_results}{\"id\":\"$id\",\"label\":\"$label\",\"status\":\"$status\",\"duration_seconds\":$duration}"
}

run_phase "pint"          "Pint (code style)"                "vendor/bin/pint --test --format=agent"
run_phase "rector"        "Rector (refactoring dry-run)"     "vendor/bin/rector --dry-run --no-progress-bar"
run_phase "phpstan"       "PHPStan L9"                       "php -d memory_limit=-1 vendor/bin/phpstan analyse --no-progress"
run_phase "type-coverage" "Pest type-coverage (100%)"        "vendor/bin/pest --type-coverage --min=100"
run_phase "unit-feature"  "Pest unit + feature"              "vendor/bin/pest --parallel --testsuite=Arch,Unit,Feature"
run_phase "browser"       "Pest browser (monolith only)"     "[ -d resources/js/Pages ] && vendor/bin/pest --filter=Browser || true" "false"
# Mutation phase: MSI thresholds live in infection.json5 (currently 0/0 for the
# v1.0.0-draft — see CHANGELOG). Marked non-required because no coverage driver
# (pcov/xdebug) is enforced locally yet; CI raises this back to required in Plan 2.
run_phase "mutation"      "Infection mutation testing"       "vendor/bin/infection --threads=4 --no-progress --no-interaction" "false"
run_phase "vitest"        "Vitest (Vue components)"          "[ -f vite.config.ts ] && bun run test 2>/dev/null || true" "false"
# Security audit: CVEs always fail the gate (required); abandoned-package
# warnings are tracked separately. nunomaduro/pao → laravel/pao migration is
# scheduled (CHANGELOG / Plan 1 F2 notes); --abandoned=ignore until then.
run_phase "security"      "Security audit"                   "composer audit --no-interaction --abandoned=ignore"
# Visual regression (Plan 2 F3 setup, Plan 5 CI enables): runs Playwright
# against Histoire stories with a 2% diff threshold per spec §6.6.E.3.
# Non-required locally — baselines may not exist until first --update-snapshots
# run, and chromium browser install is optional during development.
run_phase "visual"        "Playwright visual regression"     "[ -d tests/Visual/light-dark.spec.ts-snapshots ] && bin/wc-visual-regression --reporter=list || true" "false"

phases_results="${phases_results}]"
END_TIME=$(date +%s)
TOTAL_DURATION=$((END_TIME - START_TIME))

cat > "$REPORT_FILE" <<EOF
{
  "version": "1.0",
  "generated_at": "$(date -u +%Y-%m-%dT%H:%M:%SZ)",
  "duration_seconds": $TOTAL_DURATION,
  "verdict": "$([[ $overall_status == "passed" ]] && echo PASSED || echo FAILED)",
  "phases": $phases_results
}
EOF

if [[ "$overall_status" == "passed" ]]; then
    printf "\n✓ Quality Gate PASSED (%ds)\n  Report: %s\n  Marta / Eduardo / Francisca podem aprovar a entrega.\n" "$TOTAL_DURATION" "$REPORT_FILE"
    exit 0
else
    printf "\n✗ Quality Gate FAILED (%ds)\n  Report: %s\n" "$TOTAL_DURATION" "$REPORT_FILE"
    exit 1
fi
