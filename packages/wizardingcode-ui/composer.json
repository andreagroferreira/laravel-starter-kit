{
    "name": "wizardingcode/ui",
    "description": "Shared Vue 3 UI components for WizardingCode boilerplate (built on Nuxt UI 4).",
    "type": "library",
    "license": "MIT",
    "version": "1.0.0",
    "require": {
        "php": "^8.4",
        "illuminate/support": "^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "WizardingCode\\Ui\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WizardingCode\\Ui\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "WizardingCode\\Ui\\WizardingCodeUiServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
