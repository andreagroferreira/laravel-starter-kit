# TODO(Plan 5): clear phpstan-baseline.neon — temporary L9 baseline for 91
# pre-existing errors inherited from the Nuno starter (vendor configs +
# Spatie permission migration). New code MUST stay clean.
includes:
    - ./vendor/larastan/larastan/extension.neon
    - ./phpstan-baseline.neon

parameters:
    level: 9
    paths:
        - app
        - config
        - database
        - routes
        - tests
    excludePaths:
        - app/Console/Kernel.php (?)
        - bootstrap/cache/*
        - storage/*
        - vendor/*
        - packages/*/vendor/* (?)
    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: true
    tmpDir: storage/framework/cache/phpstan
